# Variables públicas de compilación (Astro). Copiar a .env para probar localmente.
# .env está ignorado por git; NUNCA subirlo.

# Google Tag Manager: ID del contenedor web (formato GTM-XXXXXXX). Si se deja vacío,
# no se inyecta ningún script de analítica en el sitio. La etiqueta de GA4 se configura
# dentro del contenedor, no en este archivo.
PUBLIC_GTM_ID=

# Search Console: token del método «Etiqueta HTML» (meta name=google-site-verification).
# Se publica en el <head> de todas las páginas. Si se deja vacío, no se inyecta nada.
# Alternativa sin tocar este archivo: descargar el archivo HTML de verificación
# de Search Console y colocarlo en public/ con el nombre exacto que indique Google.
PUBLIC_GSC_VERIFICATION=
