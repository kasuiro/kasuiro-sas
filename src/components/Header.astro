---
const nav = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/recursos', label: 'Recursos' },
  { href: '/auditoria-express', label: 'Auditoría Express' },
];
const path = Astro.url.pathname;
---

<header class="border-b border-line bg-bg/85 backdrop-blur">
  <div class="container-page flex min-h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 text-lg font-extrabold tracking-tight" aria-label="Kasuiro SAS, ir al inicio">
      <img
        src="/brand/kasuiro-icon-tight.png"
        alt=""
        width="389"
        height="315"
        class="h-8 w-auto shrink-0"
      />
      Kasuiro <span class="text-magenta">SAS</span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Navegación principal">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={path === item.href ? 'page' : undefined}
          class="text-sm font-medium text-muted hover:text-ink aria-[current=page]:text-magenta"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="tema-toggle"
        type="button"
        class="card !p-2 text-sm"
        aria-label="Cambiar entre modo claro y oscuro"
        title="Modo claro / oscuro"
      >
        <span aria-hidden="true">◐</span>
      </button>

      <button
        id="menu-toggle"
        type="button"
        class="card !p-2 md:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>

  <nav id="menu-movil" hidden class="border-t border-line md:hidden" aria-label="Navegación móvil">
    <ul class="container-page py-3">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={path === item.href ? 'page' : undefined}
            class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-surface aria-[current=page]:text-magenta"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-movil');
  toggle?.addEventListener('click', () => {
    const abierto = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!abierto));
    toggle.setAttribute('aria-label', abierto ? 'Abrir menú' : 'Cerrar menú');
    menu?.toggleAttribute('hidden', abierto);
  });

  const tema = document.getElementById('tema-toggle');
  tema?.addEventListener('click', () => {
    const oscuro = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('kasuiro-tema', oscuro ? 'oscuro' : 'claro'); } catch (e) {}
  });
</script>
