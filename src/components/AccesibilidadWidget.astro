---
// Widget visible de accesibilidad (Fase 2). La base técnica ya está cubierta:
// contraste, teclado, HTML semántico y foco visible.
---

<div class="fixed bottom-4 right-4 z-40 flex flex-col items-end gap-2">
  <div
    id="a11y-panel"
    hidden
    class="card w-64 !p-4 text-sm shadow-lg"
    role="group"
    aria-label="Ajustes de accesibilidad"
  >
    <p class="font-bold">Accesibilidad</p>

    <div class="mt-3">
      <p id="a11y-tamano-label" class="text-xs text-muted">Tamaño de texto</p>
      <div class="mt-1 flex gap-2" aria-labelledby="a11y-tamano-label">
        <button class="btn btn-outline !min-h-9 !px-3" type="button" data-a11y="font-down" aria-label="Reducir tamaño de texto">A−</button>
        <button class="btn btn-outline !min-h-9 !px-3" type="button" data-a11y="font-reset" aria-label="Restablecer tamaño de texto">100 %</button>
        <button class="btn btn-outline !min-h-9 !px-3" type="button" data-a11y="font-up" aria-label="Aumentar tamaño de texto">A+</button>
      </div>
    </div>

    <label class="mt-4 flex items-center gap-2">
      <input id="a11y-contraste" type="checkbox" />
      Contraste alto
    </label>
    <label class="mt-2 flex items-center gap-2">
      <input id="a11y-movimiento" type="checkbox" />
      Pausar animaciones
    </label>
  </div>

  <button
    id="a11y-toggle"
    type="button"
    class="card !p-3 text-sm font-semibold shadow-lg"
    aria-expanded="false"
    aria-controls="a11y-panel"
    aria-label="Abrir ajustes de accesibilidad"
  >
    Accesibilidad
  </button>
</div>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById('a11y-toggle');
  const panel = document.getElementById('a11y-panel');
  const contraste = document.getElementById('a11y-contraste') as HTMLInputElement | null;
  const movimiento = document.getElementById('a11y-movimiento') as HTMLInputElement | null;

  const leer = (clave: string) => {
    try { return localStorage.getItem(clave); } catch (e) { return null; }
  };
  const guardar = (clave: string, valor: string) => {
    try { localStorage.setItem(clave, valor); } catch (e) {}
  };

  const tamanoActual = () => {
    const valor = parseFloat(getComputedStyle(root).getPropertyValue('--tamano-texto'));
    return Number.isFinite(valor) ? valor : 1;
  };

  const aplicarTamano = (valor: number) => {
    const normalizado = Math.min(1.5, Math.max(0.85, Math.round(valor * 100) / 100));
    root.style.setProperty('--tamano-texto', String(normalizado));
    guardar('kasuiro-texto', String(normalizado));
  };

  toggle?.addEventListener('click', () => {
    const abierto = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!abierto));
    toggle.setAttribute('aria-label', abierto ? 'Abrir ajustes de accesibilidad' : 'Cerrar ajustes de accesibilidad');
    if (panel) panel.hidden = abierto;
  });

  document.querySelectorAll<HTMLButtonElement>('[data-a11y]').forEach((boton) => {
    boton.addEventListener('click', () => {
      const accion = boton.dataset.a11y;
      if (accion === 'font-down') aplicarTamano(tamanoActual() - 0.1);
      if (accion === 'font-up') aplicarTamano(tamanoActual() + 0.1);
      if (accion === 'font-reset') aplicarTamano(1);
    });
  });

  contraste?.addEventListener('change', () => {
    root.classList.toggle('contraste-alto', contraste.checked);
    guardar('kasuiro-contraste', contraste.checked ? 'si' : 'no');
  });

  movimiento?.addEventListener('change', () => {
    root.classList.toggle('pausar-animaciones', movimiento.checked);
    guardar('kasuiro-movimiento', movimiento.checked ? 'si' : 'no');
  });

  if (contraste) contraste.checked = root.classList.contains('contraste-alto');
  if (movimiento) movimiento.checked = root.classList.contains('pausar-animaciones');
  if (leer('kasuiro-texto')) root.style.setProperty('--tamano-texto', leer('kasuiro-texto'));
</script>
