---
import { paradas } from '../data/scroll';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="recorrido" data-world aria-label="Recorrido por Kasuiro SAS" class="relative">
  <!-- Escenario fijo: los clips se repiten en loop; el scroll solo elige cuál se ve. -->
  <div data-stage class="sticky top-0 h-lvh overflow-hidden bg-bg" style="--focus-x: 50%">
    <div aria-hidden="true" class="absolute inset-0">
      {
        paradas.map((parada, i) => (
          <div data-frame class:list={['frame', 'absolute', 'inset-0', { 'is-active': i === 0 }]}>
            <img
              src={parada.poster}
              alt=""
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'low'}
              decoding="async"
              class="size-full object-cover"
              style="object-position: var(--focus-x) 50%"
            />
          </div>
        ))
      }
      <div class="clips absolute inset-0">
        {
          paradas.map((parada) => (
            <video
              data-clip
              data-src={parada.clip}
              poster={parada.poster}
              muted
              loop
              playsinline
              autoplay
              preload="none"
              disablepictureinpicture
              disableremoteplayback
              tabindex="-1"
              class="clip absolute inset-0 size-full object-cover"
            />
          ))
        }
      </div>
    </div>

    <!-- Velos para mantener legible el texto. -->
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-40 bg-linear-to-b from-bg/60 to-transparent"></div>
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-linear-to-t from-bg from-15% via-bg/50 via-50% to-transparent to-80% lg:bg-linear-to-r lg:from-bg/90 lg:via-bg/40 lg:via-35% lg:to-transparent lg:to-65%"
    >
    </div>

    <!-- Raíl de paradas. -->
    <nav aria-label="Paradas del recorrido" class="absolute top-1/2 right-6 hidden -translate-y-1/2 lg:block xl:right-8">
      <ol class="relative flex flex-col items-end gap-4">
        <span aria-hidden="true" class="absolute top-3 right-1 bottom-3 w-px translate-x-1/2 bg-ink/20">
          <span data-rail-fill class="absolute inset-0 origin-top scale-y-0 bg-magenta"></span>
        </span>
        {
          paradas.map((parada, i) => (
            <li>
              <a
                href={`#${parada.id}`}
                data-goto
                aria-current={i === 0 ? 'true' : 'false'}
                class="rail-link group flex h-6 items-center gap-3"
              >
                <span class="rail-label rounded-full bg-bg/60 px-3 py-1 text-xs whitespace-nowrap text-ink ring-1 ring-ink/10 backdrop-blur-xl">
                  {parada.lugar}
                </span>
                <span class="relative grid size-2 place-items-center">
                  <span class="rail-dot size-2 rounded-full bg-ink/40"></span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <p
      data-hint
      aria-hidden="true"
      class="absolute right-8 bottom-8 hidden items-center gap-3 text-xs tracking-widest text-ink/70 uppercase lg:flex"
    >
      Desliza para recorrer
      <span class="hint-line relative h-px w-12 overflow-hidden bg-ink/20"></span>
    </p>
  </div>

  <!-- Cada artículo marca la distancia de scroll; su texto queda fijo abajo a la izquierda. -->
  <div class="relative z-10">
    {
      paradas.map((parada, i) => (
        <article
          id={parada.id}
          data-stop
          data-focus="50"
          class="stop pointer-events-none flex min-h-[200svh] flex-col justify-end"
        >
          <div class="stop-body pointer-events-auto sticky bottom-0 flex w-full max-w-3xl flex-col items-start px-4 pt-32 pb-12 md:px-12 lg:pb-16 xl:px-20">
            <p class="flex items-center gap-2 text-xs tracking-widest text-ink/70 uppercase">
              <span class="tabular-nums">{pad(i + 1)} / {pad(paradas.length)}</span>
              <span aria-hidden="true" class="size-1 rounded-full bg-magenta"></span>
              <span>{parada.lugar}</span>
            </p>
            <p class="mt-4 text-xs font-medium tracking-widest text-magenta uppercase">{parada.eyebrow}</p>
            {i === 0 ? (
              <h1 class="mt-4 max-w-4xl text-4xl leading-tight sm:text-6xl">{parada.titulo}</h1>
            ) : (
              <h2 class="mt-4 max-w-3xl text-3xl leading-tight sm:text-5xl">{parada.titulo}</h2>
            )}
            <p class="mt-5 max-w-2xl text-base text-muted sm:text-lg">{parada.texto}</p>
            <a
              class:list={['btn', 'mt-7', { 'btn-outline': parada.cta.outline }]}
              href={parada.cta.href}
            >
              {parada.cta.texto}
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  import '../scripts/motion';
</script>

<style>
  .frame {
    opacity: 0;
    transition: opacity 900ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity;
  }

  .frame.is-active {
    opacity: 1;
  }

  .clips {
    opacity: 0;
    transition: opacity 1200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-mode='video'] .clips {
    opacity: 1;
  }

  /* Los clips siguen en bucle aunque cambie la parada; el scroll solo decide cuál se ve. */
  .clip {
    object-position: var(--focus-x) 50%;
    opacity: 0;
    transition: opacity 1200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .clip.is-shown {
    opacity: 1;
  }

  .rail-label {
    opacity: 0;
    transform: translateX(0.5rem);
    transition:
      opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .rail-dot {
    transition:
      background-color 700ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .rail-link:hover .rail-label,
  .rail-link:focus-visible .rail-label,
  .rail-link[aria-current='true'] .rail-label {
    opacity: 1;
    transform: none;
  }

  .rail-link:hover .rail-dot {
    background-color: var(--color-magenta);
  }

  .rail-link[aria-current='true'] .rail-dot {
    background-color: var(--color-magenta);
    transform: scale(1.5);
  }

  .hint-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-ink);
    animation: hint 2400ms cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  :global(.js) .stop-body > :global(*) {
    opacity: 0;
    transform: translateY(2rem);
    transition:
      opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.js) .stop.is-current .stop-body > :global(*),
  :global(.js) .stop-body:focus-within > :global(*) {
    opacity: 1;
    transform: none;
    transition-duration: 1000ms;
  }

  .stop.is-current .stop-body > :global(:nth-child(2)) { transition-delay: 60ms; }
  .stop.is-current .stop-body > :global(:nth-child(3)) { transition-delay: 120ms; }
  .stop.is-current .stop-body > :global(:nth-child(4)) { transition-delay: 180ms; }
  .stop.is-current .stop-body > :global(:nth-child(5)) { transition-delay: 240ms; }
  .stop.is-current .stop-body > :global(:nth-child(6)) { transition-delay: 300ms; }

  :global(.js) .stop:not(.is-current) .stop-body:not(:focus-within) {
    pointer-events: none;
  }

  @keyframes hint {
    from { transform: translateY(-100%); }
    to { transform: translateY(100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hint-line::after {
      animation: none;
    }
    :global(.js) .stop-body > :global(*) {
      transform: none;
    }
  }
</style>
