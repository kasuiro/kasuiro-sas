---
const year = new Date().getFullYear();
// El control de medición solo aparece si GTM está configurado en el build.
const medicionDisponible = Boolean(import.meta.env.PUBLIC_GTM_ID);
---

<footer class="mt-20 border-t border-line py-10">
  <div class="container-page flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="flex items-center gap-2 font-extrabold tracking-tight">
        <img
          src="/brand/kasuiro-icon-tight-80.webp"
          alt=""
          width="80"
          height="65"
          class="h-8 w-auto shrink-0"
        />
        Kasuiro <span class="text-magenta">SAS</span>
      </p>
      <p class="mt-1 text-sm text-muted">Tu Departamento de Tecnología Externalizado</p>
    </div>
    <nav class="flex flex-wrap gap-4 text-sm text-muted" aria-label="Enlaces legales">
      <a class="hover:text-ink" href="/habeas-data">Habeas Data</a>
      <a class="hover:text-ink" href="/recursos">Recursos</a>
    </nav>
    <p class="text-sm text-muted">© {year} Kasuiro SAS</p>
  </div>
  {medicionDisponible && (
    <label class="container-page mt-4 flex items-center gap-2 text-xs text-muted">
      <input id="medicion-optin" type="checkbox" />
      Permitir medición de uso del sitio (se aplica al recargar)
    </label>
  )}
</footer>

{medicionDisponible && (
  <script define:vars={{ medicionDisponible: true }}>
    (function () {
      var casilla = document.getElementById('medicion-optin');
      if (!casilla) return;
      try {
        casilla.checked = localStorage.getItem('kasuiro-analitica') === 'si';
      } catch (e) {}
      casilla.addEventListener('change', function () {
        try {
          localStorage.setItem('kasuiro-analitica', casilla.checked ? 'si' : 'no');
        } catch (e) {}
      });
    })();
  </script>
)}
