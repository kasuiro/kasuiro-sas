---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const servicios = (await getCollection('servicios'))
  .filter((entrada) => !entrada.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Servicios"
  description="Auditoría Express y Ruta de Madurez Digital: tres fases para ordenar la operación, automatizar la venta y conectar los datos."
>
  <section class="container-page py-16">
    <p class="eyebrow">Servicios</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">Orden, automatización y datos</h1>
    <p class="mt-5 max-w-2xl text-lg text-muted">
      Estrategia, tecnología y operación con un solo socio. Puedes empezar por un diagnóstico
      de 3 días o contratar las fases de la Ruta de Madurez Digital.
    </p>
    <ul class="mt-12 grid gap-5 md:grid-cols-2">
      {servicios.map(({ id, data }) => (
        <li class="card flex flex-col gap-3">
          {data.maturityOrder > 0 && <span class="eyebrow">Fase {data.maturityOrder}</span>}
          <h2 class="text-2xl">{data.title}</h2>
          <p class="text-sm text-muted">{data.summary}</p>
          <a class="mt-auto text-sm font-semibold text-cian-texto hover:underline" href={`/servicios/${data.slug || id}`}>
            Ver detalle
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
