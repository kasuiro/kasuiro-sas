---
import Layout from '../layouts/Layout.astro';
import ScrollStage from '../components/ScrollStage.astro';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Kasuiro S.A.S.',
  slogan: 'Tu Departamento de Tecnología Externalizado',
  description: 'Ayuda a pymes a digitalizar sus procesos sin contratar un equipo de TI completo.',
  url: Astro.site?.href,
  inLanguage: 'es',
}).replaceAll('<', '\\u003c');
---

<Layout
  title="Tu Departamento de Tecnología Externalizado"
  description="Ayudamos a pymes a digitalizar sus procesos sin contratar un equipo de TI completo. Auditoría, implementación y soporte continuo con herramientas open source."
>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />

  <ScrollStage />
</Layout>
