---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada" description="La página solicitada no existe." noindex>
  <section class="container-page py-24">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">No encontramos esa página</h1>
    <p class="mt-5 text-muted">Puede que el enlace haya cambiado.</p>
    <a class="btn mt-8" href="/">Volver al inicio</a>
  </section>
</Layout>
